# GitHub, transcribed from the iTerm2-Color-Schemes palette:
# https://github.com/mbadolato/iTerm2-Color-Schemes/blob/master/schemes/GitHub.itermcolors
#
# Ghostty bundles that scheme collection, so `theme = GitHub` is the one-line
# equivalent of everything below. The palette is spelled out instead so the
# colors are pinned here and greppable, and so the contrast note below has
# somewhere to live.
#
# Upstream leans on several near-white values (palette 3, 7, 10, 14, 15) that
# have almost no contrast against the f4f4f4 background: pale yellow and white
# text read as invisible. Darken those if it bites.

background = #f4f4f4
foreground = #3e3e3e

# normal
palette = 0=#3e3e3e
palette = 1=#970b16
palette = 2=#07962a
palette = 3=#f8eec7
palette = 4=#003e8a
palette = 5=#e94691
palette = 6=#89d1ec
palette = 7=#ffffff

# bright
palette = 8=#666666
palette = 9=#de0000
palette = 10=#87d5a2
palette = 11=#f1d007
palette = 12=#2e6cba
palette = 13=#ffa29f
palette = 14=#1cfafe
palette = 15=#ffffff

selection-background = #a9c1e2
selection-foreground = #535353

cursor-color = #3f3f3f
cursor-text = #f4f4f4
