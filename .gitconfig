# This file is included by a real, untracked ~/.gitconfig rather than symlinked
# to it; see install.sh. Anything a tool writes with `git config --global` lands
# in that outer file, so machine-local state stays out of version control.
#
# No email here on purpose. These dotfiles are shared between personal and work
# machines, and an address committed here would follow the repo onto all of them.
# useConfigOnly makes git refuse to guess an author instead of silently
# attributing commits to whichever identity happens to be configured, so a
# machine with no identity set fails loudly rather than committing as the wrong
# person.
[user]
	useConfigOnly = true
	name = Austin Pray

[core]
	excludesfile = ~/dotfiles/.gitignore_global
	editor = vim
	pager = delta

[rerere]
	enabled = true
[rebase]
	autosquash = true
[pull]
	ff = only

[push]
	default = simple

[interactive]
	diffFilter = delta --color-only

[color]
	ui = true
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
